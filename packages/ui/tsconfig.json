{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@lunari/types": ["../types/src/index.ts"],
      "@lunari/design-tokens": ["../design-tokens/tokens.ts"],
      "@lunari/phase-data": ["../phase-data/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
