generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  name              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  onboardedAt           DateTime? @map("onboarded_at") @db.Timestamptz
  notificationPrefs     Json      @default("{\"dailyReminder\": true, \"reminderTime\": \"08:00\"}") @map("notification_prefs")
  referralCode          String?   @map("referral_code")
  referralCodeAppliedAt DateTime? @map("referral_code_applied_at") @db.Timestamptz
  lastActiveAt          DateTime? @default(now()) @map("last_active_at") @db.Timestamptz

  cycles       Cycle[]
  symptomLogs  SymptomLog[]
  periodEvents PeriodEvent[]
  orders       Order[]
  subscriptions Subscription[]

  @@map("users")
}

model Cycle {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  startDate    DateTime @map("start_date") @db.Date
  cycleLength  Int      @default(28) @map("cycle_length")
  periodLength Int      @default(5) @map("period_length")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("cycles")
}

// Real bleed-start events logged by the user. These OVERRIDE the onboarding Cycle
// at prediction time (via getEffectiveCycle) — the Cycle row itself is never mutated.
model PeriodEvent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("period_events")
}

model SymptomLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  cycleDay     Int      @map("cycle_day")
  phase        String
  symptoms     String[] @default([])
  journalNote  String   @default("") @map("journal_note")
  mood         Int?
  energyLevel  Int?     @map("energy_level")
  sleepHours   Decimal? @map("sleep_hours") @db.Decimal(4, 1)
  waterGlasses Int?     @map("water_glasses")
  flow         String?  // daily bleed intensity: none | spotting | light | medium | heavy (app-validated)
  loggedAt     DateTime @default(now()) @map("logged_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("symptom_logs")
}

model Order {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String?  @map("user_id") @db.Uuid
  stripeSessionId     String?  @unique @map("stripe_session_id")
  status              String   @default("pending")
  productSku          String   @map("product_sku")
  quantity            Int      @default(1)
  totalCents          Int      @map("total_cents")
  shippingAddress     Json?    @map("shipping_address")
  fulfillmentTracking String?  @map("fulfillment_tracking")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("orders")
}

model Subscription {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  status               String   @default("active")
  nextBillingDate      DateTime? @map("next_billing_date") @db.Date
  interval             String   @default("monthly")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model InfluencerReferral {
  id                   String   @id @default(uuid()) @db.Uuid
  influencerCode       String   @unique @map("influencer_code")
  influencerName       String   @map("influencer_name")
  commissionRate       Decimal  @default(0.20) @map("commission_rate")
  totalSales           Int      @default(0) @map("total_sales")
  totalCommissionCents Int      @default(0) @map("total_commission_cents")
  appAttributions      Int      @default(0) @map("app_attributions")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("influencer_referrals")
}
