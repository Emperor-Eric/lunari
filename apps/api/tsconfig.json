{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "declaration": false,
    "paths": {
      "@lunari/types": ["../../packages/types/src/index.ts"],
      "@lunari/phase-data": ["../../packages/phase-data/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
